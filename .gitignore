# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# netlify
.netlify
# stray edge-functions lockfile netlify writes at the root
deno.lock

# claude code local settings
.claude/

# local data / imports (contain real customer data — do NOT commit)
/venio database/
/supabase/import_*.sql
# filled-in copies of the templates in /import-templates
/import-data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local data backups (JSON) — never commit real data
backups/
